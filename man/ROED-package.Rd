\name{ROED-package}
\alias{ROED}
\alias{ROED-package}
\docType{package}
\title{Robustly Optimal Exact Designs}
\description{
ROED constructs deterministic exact designs for randomized dose-optimization
trials with co-primary binary toxicity and efficacy endpoints.
}
\details{
The package minimizes total sample size subject to exact strong familywise
error control and a finite-scenario maximin generalized-power requirement.
The main workflow uses \code{roed_scenarios()}, \code{roed_design()},
\code{roed_oc()}, \code{roed_protocol()}, and \code{roed_select()}.
}
\author{ROED Development Team}

